#include <SPI.h>
#include <mcp_can.h>

// ======== TU CÓDIGO ORIGINAL (SIN CAMBIOS EN LA LÓGICA) ========

// Definiciones de pines CAN
#define CAN_CS    5
#define CAN_SCK   18
#define CAN_S0    19
#define CAN_S1    23

MCP_CAN CAN0(CAN_CS);  // Definir el pin CS para el bus CAN

// --- AÑADIDO: Umbral para 0x311 (porcentaje→binario) ---
#define THRESH_311 50

void setup() {
  Serial.begin(115200);
  while (!Serial);

  // Inicializa el bus CAN
  if (CAN0.begin(MCP_ANY, CAN_500KBPS, MCP_8MHZ) == CAN_OK) {
    Serial.println("CAN BUS listo!");
  } else {
    Serial.println("Error al iniciar MCP2515. Verifique la conexión CAN.");
    while (1);  // Si no se puede conectar, detén el programa aquí.
  }

  CAN0.setMode(MCP_NORMAL);  // Establecer el modo normal para el CAN
  Serial.println("CAN BUS configurado y listo para enviar mensajes.");
}

void loop() {
  // ==== ENVÍO: lee comandos por Serial como "200 75" ====
  if (Serial.available()) {
    String input = Serial.readStringUntil('\n');
    input.trim();

    if (input.length() > 0) {
      enviarMensajeCAN(input);
    }
  }

  // ==== FEEDBACK: escucha mensajes CAN entrantes ====
  leerCAN();   // <--- agregado para recibir feedback (IDs 0x201 y 0x301)
}

// Función para enviar el mensaje por CAN
void enviarMensajeCAN(String s) {
  int spaceIndex = s.indexOf(' ');  // Busca el espacio para separar ID y valor
  if (spaceIndex == -1) {
    Serial.println("Formato incorrecto. Usa: ID valor (Ej: 200 75)");
    return;
  }

  String idStr = s.substring(0, spaceIndex);  // Extrae el ID
  String valStr = s.substring(spaceIndex + 1);  // Extrae el valor
  idStr.trim();
  valStr.trim();

  unsigned long txId = strtoul(idStr.c_str(), NULL, 16);  // Convierte el ID de hexadecimal a decimal
  int valor = valStr.toInt();  // Convierte el valor a entero

  if (valor < 0) valor = 0;        // clamp a 0
  if (valor > 100) valor = 100;    // clamp a 100

  byte data[1];
  data[0] = (byte)valor;

  byte sndStat = CAN0.sendMsgBuf(txId, 0, 1, data);  // Envía el mensaje por CAN

  if (sndStat == CAN_OK) {
    Serial.print("[TX OK] ID:0x");
    Serial.print(txId, HEX);  // Muestra el ID en formato hexadecimal
    Serial.print(" Valor: ");
    Serial.print(valor);
    Serial.println("%");
  } else {
    Serial.println("[TX FAIL] Error al enviar mensaje CAN.");
  }
}

// ======== FEEDBACK AÑADIDO (DE TU SEGUNDO CÓDIGO) ========
void leerCAN() {
  long unsigned int rxId;
  unsigned char len = 0;
  unsigned char rxBuf[8];

  // ¿Hay mensaje disponible?
  if (CAN0.checkReceive() == CAN_MSGAVAIL) {
    if (CAN0.readMsgBuf(&rxId, &len, rxBuf) == CAN_OK) {

      // --- AÑADIDO: Caso binario Activado/Desactivado para ID 0x311 ---
      if (rxId == 0x311 && len >= 1) {
      int valor311 = rxBuf[0];                 // número recibido (0–100 o 0/1)
      int bit = (valor311 >= THRESH_311) ? 1 : 0; // si viene en %, usa umbral
      // Si ya envían 0/1 directo, podrías usar: int bit = valor311 ? 1 : 0;

      Serial.print("[RX OK] Estado (ID:0x311) → valor=");
      Serial.print(valor311);

      }

      // Espera feedback en 0x101 y/o 0x201 (1 byte = porcentaje 0-100)
      else if ((rxId == 0x101 || rxId == 0x201 || rxId == 0x301) && len >= 1) {
        int valor = rxBuf[0];

        if (rxId == 0x201) {
          Serial.print("[RX OK] Feedback de Frenos (ID:0x201) → ");
        } else if (rxId == 0x101) {
          Serial.print("[RX OK] Feedback de Dirección (ID:0x101) → ");
        } else if (rxId == 0x301) {
          Serial.print("[RX OK] Feedback de Tren Motriz (ID:0x301) → ");
        }
        Serial.print(valor);
        Serial.println("%");
      } else {
        // (Opcional) Descomenta si quieres ver otros frames que llegan
        // Serial.print("[RX] ID:0x"); Serial.print(rxId, HEX);
        // Serial.print(" Len:"); Serial.print(len);
        // Serial.print(" Data:");
        // for (byte i = 0; i < len; i++) { Serial.print(" "); Serial.print(rxBuf[i], HEX); }
        // Serial.println();
      }
    } else {
      Serial.println("[RX FAIL] Error al leer buffer CAN.");
    }
  }
}
